[Unit]
Description=Nested X11 bench for AI agents (%i)

[Service]
Type=simple
ExecStart=@PREFIX@/bin/agent-bench _boot %i
# Chromium first, so it flushes cookies instead of dying with Xvnc under it.
ExecStop=@PREFIX@/bin/agent-bench _close-browser %i
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
UMask=0077
MemoryAccounting=yes
MemoryHigh=4G
MemoryMax=6G
CPUWeight=50
TasksMax=4096

[Install]
WantedBy=default.target
