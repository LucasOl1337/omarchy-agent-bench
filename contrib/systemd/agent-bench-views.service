[Unit]
Description=Place agent-bench viewers on Hyprland workspaces 6–11
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 @PREFIX@/desktop/bench_views.py
KillMode=control-group
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=graphical-session.target
